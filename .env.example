# Everything this deployment knows that the source does not.
#
# All of it is optional. A checkout with no configuration builds and runs — you
# can clone this and be painting on a wall a minute later, without being asked
# for an analytics account first. Whatever is missing simply does not appear:
# no id means no tracker, no form URL means no button.
#
# Copy to .env.local for development. In production these are set wherever the
# site is hosted (on Netlify: Site configuration → Environment variables).

# --- Analytics -------------------------------------------------------------
# Umami website id. Leave empty and no tracker is ever loaded, so a fork does
# not report its visitors to somebody else's dashboard.
VITE_UMAMI_ID=
# Only needed for a self-hosted Umami. Defaults to their cloud script.
VITE_UMAMI_SRC=

# --- The corner of the front screen ----------------------------------------
# Where this deployment's source lives. Under the AGPL a modified version
# served over a network owes its source to the people using it — this is where
# that offer is made, so point it at your own repository.
VITE_LINK_SOURCE=

# --- Where people send things ----------------------------------------------
# A bug report. One link for both languages: it is mostly a screenshot and a
# sentence, and two inboxes would be two things to forget to check.
VITE_LINK_BUG=

# "Send your image", one per language. Split because handing an English speaker
# a Portuguese form at the moment they try to give you something loses them.
VITE_FORM_SUBMIT_PT=
VITE_FORM_SUBMIT_EN=
